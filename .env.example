# Copy this file to backend/.env and fill in your own values. NEVER commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=sqlite:///./geno.db
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL(s) allowed to call the API, comma-separated (Vite's default dev URL)
CORS_ORIGINS=http://localhost:5173

# Leave empty to run in "dev mode" (replies echo your message). Set it to use the real AI.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Keep false in production (payments are not integrated yet)
ALLOW_FREE_PLAN_CHANGE=false
