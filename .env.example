PORT=3000
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# https://console.anthropic.com  (empty = demo mode with canned replies)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Plans (messages per day) and prices ---
CURRENCY=EGP
FREE_DAILY=50
PLUS_DAILY=200
PRO_DAILY=2000
PRICE_PLUS=99
PRICE_PRO=199

# --- Manual payments (InstaPay, Vodafone Cash, ...) ---
PAYMENT_METHODS=InstaPay,Vodafone Cash
PAYMENT_INSTRUCTIONS=Send the plan price to 01XXXXXXXXX (name), then enter the transaction number below.
# Secret used to approve payments via the admin API
ADMIN_TOKEN=

# --- Optional: better Arabic speech-to-text on the server (OpenAI transcription API) ---
OPENAI_API_KEY=
STT_MODEL=whisper-1

# --- Optional: WhatsApp (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Marketing execution (Plan screen) ---
# Safety cap for one Meta ad's daily test budget, in your ad account currency
MK_MAX_DAILY_BUDGET=50

# --- Launch ---
NODE_ENV=production         # in production the server refuses to start without a 32+ character JWT_SECRET
COMPANY_NAME=               # shown in /privacy and /terms (templates: have a lawyer review them)
CONTACT_EMAIL=              # shown in /privacy, /terms and /data-deletion
